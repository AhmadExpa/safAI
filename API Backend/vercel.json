{
  "version": 2,
  "builds": [
    {
      "src": "api/handler.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/handler.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  }
}
